{
  "name": "Flutter Web Environment",
  "image": "://microsoft.com",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Flutter Web App",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "git clone https://github.com -b stable ~/flutter && echo 'export PATH=\"$HOME/flutter/bin:$PATH\"' >> ~/.bashrc"
}
