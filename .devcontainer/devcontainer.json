{
  "name": "Flutter Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  },

  "forwardPorts": [
    8080
  ],

  "portsAttributes": {
    "8080": {
      "label": "Flutter Web",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  }
}
